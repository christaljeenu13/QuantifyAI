# Featherless AI Configuration (OpenAI-compatible)
# Sign up at https://featherless.ai to obtain your API key
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Market Data Configuration
# yfinance does not require an API key by default.
# Optional fallback provider key if used:

# Quantitative Analysis Defaults
RISK_FREE_RATE=0.04
DEFAULT_INITIAL_CAPITAL=10000.0
DEFAULT_TRANSACTION_FEE=0.001
